<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Optim8 - Sidebar Mockup</title>
<style>
:root {
  --sidebar-width: 252px;
  --navy: #173248;
  --text: #293d50;
  --muted: #738395;
  --line: #e1e8ee;
  --teal: #087f87;
}
* { box-sizing: border-box; }
[hidden] { display: none !important; }

body {
  margin: 0;
  background: #f4f7fa;
  color: var(--text);
  font: 14px/1.5 "Segoe UI", Arial, sans-serif;
}
body.collapsed { --sidebar-width: 72px; }

button, input, textarea { font: inherit; }
button { cursor: pointer; color: inherit; border: 0; background: none; }
button:focus-visible, input:focus-visible, textarea:focus-visible {
  outline: 3px solid #66c6ce;
  outline-offset: 2px;
}

.sidebar {
  position: fixed;
  inset: 0 auto 0 0;
  width: var(--sidebar-width);
  background: var(--navy);
  color: #d6e0e8;
  display: flex;
  flex-direction: column;
  z-index: 40;
}
.brand {
  height: 77px;
  flex-shrink: 0;
  padding: 17px 24px;
  border-bottom: 1px solid #ffffff16;
}
.logo {
  color: white;
  font-size: 31px;
  font-weight: 800;
  letter-spacing: -1.8px;
}
.logo span { color: #c58d96; }

.sidebar-controls {
  padding: 10px 14px;
  border-bottom: 1px solid #ffffff16;
  flex-shrink: 0;
}
.controls-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.controls-label {
  color: #aebfcd;
  font-size: 10px;
  letter-spacing: .8px;
  text-transform: uppercase;
}
.width-toggle {
  display: grid;
  place-items: center;
  width: 30px;
  height: 30px;
  padding: 0;
  color: #dce7ee;
  background: #ffffff10;
  border: 1px solid #ffffff20;
  border-radius: 6px;
}
.width-toggle:hover { background: #ffffff20; }
.width-toggle svg { width: 18px; height: 18px; }
.show-all {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 9px;
  font-size: 11px;
  color: #c2d1dd;
  cursor: pointer;
}
.show-all input {
  width: 14px;
  height: 14px;
  margin: 0;
  accent-color: #6bbabf;
}

.navigation {
  flex: 1;
  min-height: 0;
  padding: 12px;
  overflow-y: auto;
  overflow-x: hidden;
  scrollbar-width: thin;
  scrollbar-color: #587184 transparent;
}
.navigation::-webkit-scrollbar { width: 7px; }
.navigation::-webkit-scrollbar-thumb {
  background: #587184;
  border-radius: 8px;
}

.home-button, .nav-button {
  display: flex;
  align-items: center;
  gap: 11px;
  width: 100%;
  text-align: left;
  border-radius: 6px;
  padding: 9px 12px;
  color: #d6e0e8;
  font-size: 12px;
}
.home-button {
  margin-bottom: 12px;
  background: #2b4b61;
  color: white;
}
.nav-button:hover { color: white; background: #ffffff0c; }
.nav-button.active, .nav-button.flyout-active {
  background: #2b4b61;
  color: white;
}
.nav-icon {
  width: 20px;
  height: 20px;
  flex-shrink: 0;
  color: var(--accent, #c5d8e5);
}
.nav-label { flex: 1; }
.nav-chevron { margin-left: auto; color: #8ba4b6; }
.nav-group {
  border-top: 1px solid #ffffff16;
  padding: 9px 0;
  margin-top: 4px;
}
.green { --accent: #8fd799; }
.blue { --accent: #8bc6d9; }
.yellow { --accent: #e5d779; }

.submenu {
  border-left: 1px solid #ffffff25;
  margin: 5px 0 7px 22px;
  padding: 1px 0 1px 10px;
}
.submenu button {
  display: block;
  width: 100%;
  padding: 7px 10px;
  border-radius: 5px;
  color: #b5c5d1;
  font-size: 11px;
  line-height: 1.4;
  text-align: left;
}
.submenu button:hover { color: white; background: #ffffff0c; }
.submenu button.selected { color: white; background: #2a5265; }
.side-footer {
  flex-shrink: 0;
  padding: 13px 24px;
  border-top: 1px solid #ffffff16;
  color: #93aabb;
  font-size: 10px;
}
.side-footer button { padding: 0; font-size: 10px; color: inherit; }

.main { margin-left: var(--sidebar-width); }
header { background: white; border-bottom: 1px solid var(--line); }
.header-main {
  min-height: 77px;
  padding: 15px 30px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
}
.park strong { display: block; font-size: 14px; font-weight: 650; }
.text-button { padding: 0; color: var(--teal); font-size: 11px; }
.text-button:hover { text-decoration: underline; }
.utilities { display: flex; align-items: center; gap: 24px; }
.utility { padding: 7px 0; font-size: 12px; }
.utility:hover { color: var(--teal); }
.account-wrap { position: relative; }
.account-button { display: flex; align-items: center; gap: 9px; padding: 0; }
.avatar {
  display: grid;
  place-items: center;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: #e8eff4;
  color: #3e6178;
  font-size: 12px;
  font-weight: 700;
}
.account-name { font-size: 12px; font-weight: 600; }
.account-menu {
  position: absolute;
  right: 0;
  top: 46px;
  width: 220px;
  padding: 7px;
  border: 1px solid var(--line);
  border-radius: 9px;
  background: white;
  box-shadow: 0 12px 40px #16344c24;
  z-index: 50;
}
.menu-heading {
  padding: 10px;
  border-bottom: 1px solid var(--line);
  margin-bottom: 4px;
}
.menu-heading strong { display: block; font-size: 12px; }
.menu-heading small { color: var(--muted); font-size: 10px; }
.menu-item {
  display: block;
  width: 100%;
  padding: 10px;
  border-radius: 5px;
  text-align: left;
  font-size: 12px;
}
.menu-item:hover { background: #f0f5f8; }

.header-notices { padding: 0 30px 10px; }
.notice {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px 15px;
  padding: 7px 11px;
  border-radius: 5px;
  font-size: 11px;
}
.notice + .notice { margin-top: 5px; }
.notice .text-button {
  margin-left: auto;
  font-size: 10px;
  white-space: nowrap;
}
.billing { background: #fff3e4; color: #825622; }
.billing .text-button { color: #825622; }
.release { background: #eef5f9; color: #4b7187; }

.content { max-width: 1600px; margin: auto; padding: 25px 30px; }
.page-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
}
h1 { margin: 0; font-size: 23px; letter-spacing: -.5px; font-weight: 650; }
.page-date { color: var(--muted); font-size: 11px; }
.home-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 340px;
  gap: 23px;
  align-items: start;
}
.card {
  background: white;
  border: 1px solid var(--line);
  border-radius: 10px;
  overflow: hidden;
}
.card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  padding: 18px 20px 13px;
}
h2 { margin: 0; font-size: 14px; font-weight: 650; }
.card-head small { color: var(--muted); font-size: 10px; }
.attention-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0 25px;
  padding: 0 20px 12px;
}
.attention-link {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  padding: 10px 0;
  border-bottom: 1px solid #edf1f5;
  text-align: left;
  font-size: 11px;
}
.attention-link:hover { color: var(--teal); }
.badge {
  min-width: 23px;
  padding: 1px 6px;
  border-radius: 5px;
  background: #fff0d7;
  color: #956824;
  text-align: center;
  font-size: 10px;
  font-weight: 650;
  flex-shrink: 0;
}
.badge.zero { background: #eef3f7; color: #788b9c; }
.attention-link.critical { color: #ad5145; }
.attention-link.critical .badge { background: #fbedeb; color: #ad5145; }
.status {
  display: flex;
  flex-wrap: wrap;
  gap: 7px 22px;
  padding: 12px 20px;
  border-top: 1px solid var(--line);
  background: #fafbfd;
}
.status button { padding: 0; color: var(--muted); text-align: left; font-size: 10px; }
.status button:hover { color: var(--teal); }

.dashboard-space { margin-top: 23px; }
.dashboard-body { padding: 0 20px 20px; }
.dashboard-empty {
  min-height: 230px;
  padding: 30px;
  border: 1px dashed #ccd9e3;
  border-radius: 8px;
  background: #fafcfd;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  text-align: center;
}
.dashboard-empty strong { font-size: 13px; font-weight: 600; }
.dashboard-empty p {
  max-width: 340px;
  margin: 7px 0 0;
  color: var(--muted);
  font-size: 12px;
}
.concept-tag {
  padding: 3px 7px;
  border-radius: 4px;
  background: #edf3f7;
  color: #8092a3;
  font-size: 9px;
  letter-spacing: .7px;
  text-transform: uppercase;
}
.primary {
  padding: 7px 10px;
  border-radius: 5px;
  background: var(--teal);
  color: white;
  font-size: 11px;
  font-weight: 600;
}
.primary:hover { background: #09676d; }
.notes-content { padding: 0 20px; }
.day-group { border-top: 1px solid var(--line); padding: 13px 0 2px; }
.day-label {
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: #6e8496;
  font-size: 10px;
  font-weight: 650;
}
.day-label span:last-child { font-size: 9px; font-weight: 400; }
.note {
  display: block;
  width: 100%;
  padding: 10px 0 12px;
  border-bottom: 1px solid #eef2f5;
  text-align: left;
}
.note:last-child { border-bottom: 0; }
.note strong { font-size: 11px; font-weight: 600; }
.note:hover strong { color: var(--teal); }
.note p { margin: 4px 0 6px; color: #6b7e90; font-size: 11px; white-space: pre-wrap; }
.note small { color: #8e9ba8; font-size: 9px; }
.notes-footer { padding: 13px 20px; border-top: 1px solid var(--line); }

footer {
  display: flex;
  justify-content: space-between;
  gap: 15px;
  margin-top: 25px;
  padding-top: 14px;
  border-top: 1px solid var(--line);
  color: #91a0af;
  font-size: 10px;
}
.destination { min-height: 250px; padding: 25px; }
.destination p { max-width: 650px; color: var(--muted); font-size: 13px; }
.destination .text-button { margin-top: 20px; }

/* Collapsed icon rail */
body.collapsed .brand { padding: 19px 0; text-align: center; }
body.collapsed .logo { font-size: 25px; letter-spacing: -1px; }
body.collapsed .sidebar-controls { padding: 9px 0; }
body.collapsed .controls-top { justify-content: center; }
body.collapsed .controls-label,
body.collapsed .show-all,
body.collapsed .nav-label,
body.collapsed .nav-chevron,
body.collapsed .submenu,
body.collapsed .side-footer { display: none !important; }
body.collapsed .navigation { padding: 12px 9px; }
body.collapsed .home-button,
body.collapsed .nav-button { justify-content: center; padding: 11px 0; }
body.collapsed .nav-icon { width: 21px; height: 21px; }
body.collapsed .nav-group { padding: 7px 0; }

/* Flyout overlays the page instead of narrowing it */
.flyout {
  position: fixed;
  width: 265px;
  max-width: calc(100vw - 95px);
  max-height: calc(100vh - 24px);
  overflow-y: auto;
  padding: 8px;
  background: white;
  border: 1px solid #dbe5ed;
  border-radius: 10px;
  box-shadow: 0 12px 40px #17324828;
  z-index: 100;
}
.flyout-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8px 10px 12px;
  margin-bottom: 4px;
  border-bottom: 1px solid var(--line);
  font-size: 13px;
  font-weight: 650;
}
.flyout-close {
  width: 25px;
  height: 25px;
  padding: 0;
  border-radius: 4px;
  color: var(--muted);
  font-size: 18px;
}
.flyout-item {
  display: block;
  width: 100%;
  padding: 10px;
  border-radius: 5px;
  text-align: left;
  font-size: 12px;
}
.flyout-item:hover, .flyout-close:hover { background: #edf5f7; color: var(--teal); }
.tooltip {
  position: fixed;
  max-width: 235px;
  padding: 7px 11px;
  border-radius: 6px;
  background: #102638;
  color: white;
  box-shadow: 0 4px 14px #17324825;
  font-size: 12px;
  pointer-events: none;
  z-index: 110;
}

dialog {
  width: min(560px, 92vw);
  max-height: 85vh;
  padding: 25px;
  border: 1px solid var(--line);
  border-radius: 12px;
  color: var(--text);
  box-shadow: 0 20px 90px #18354e30;
}
dialog::backdrop { background: #18354e66; }
dialog h2 { margin-bottom: 12px; }
dialog p { color: var(--muted); font-size: 12px; }
dialog label { display: block; margin: 13px 0 5px; font-size: 12px; }
input, textarea {
  width: 100%;
  padding: 10px;
  border: 1px solid #cdd9e3;
  border-radius: 6px;
  background: white;
  color: var(--text);
}
textarea { min-height: 110px; }
.dialog-actions { display: flex; justify-content: flex-end; margin-top: 20px; }
.secondary {
  padding: 7px 12px;
  border: 1px solid var(--line);
  border-radius: 5px;
  background: white;
  font-size: 12px;
}
.option {
  display: flex;
  justify-content: space-between;
  gap: 10px;
  width: 100%;
  padding: 13px 0;
  border-bottom: 1px solid var(--line);
  text-align: left;
  font-size: 12px;
}
.option:hover { color: var(--teal); }
.mobile-toggle { display: none; padding: 0; font-size: 20px; }

@media (min-width: 1600px) {
  .content { padding: 30px 38px; }
  .home-grid { grid-template-columns: minmax(0, 1fr) 365px; gap: 28px; }
  .dashboard-empty { min-height: 290px; }
}
@media (max-width: 1150px) {
  .home-grid { grid-template-columns: 1fr; }
  .notes-content { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .day-group { border-top: 0; }
  .dashboard-empty { min-height: 180px; }
}
@media (max-width: 760px) {
  .sidebar { transform: translateX(-100%); }
  .sidebar.visible { transform: translateX(0); }
  .main { margin-left: 0; }
  .mobile-toggle { display: block; }
  .header-main { padding: 13px 18px; gap: 15px; flex-wrap: wrap; }
  .utilities { margin-left: auto; gap: 15px; }
  .header-notices { padding: 0 18px 10px; }
  .content { padding: 22px 18px; }
  .account-name, .page-date { display: none; }
  .attention-grid { grid-template-columns: 1fr; }
  .notes-content { display: block; }
  .day-group { border-top: 1px solid var(--line); }
}

/* Keep the actual logo in the header at a consistent size. */
.header-logo {
  display: block;
  width: 155px;
  height: auto;
  flex-shrink: 0;
}

.header-main .park {
  margin-right: auto;
  padding-left: 22px;
  border-left: 1px solid var(--line);
}

.header-main .utilities {
  margin-left: auto;
}

/* Align the sidebar controls with the main header. */
.sidebar-controls {
  min-height: 77px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

body.collapsed .sidebar-controls {
  min-height: 77px;
}

@media (max-width: 760px) {
  .header-logo {
    width: 125px;
  }

  .header-main .park {
    padding-left: 14px;
  }

  .header-main .utilities {
    width: 100%;
    justify-content: flex-end;
    padding-top: 8px;
  }
}

.home-preview-controls {display:flex;align-items:center;gap:16px;flex-wrap:wrap;justify-content:flex-end}
.notice-preview {display:inline-flex;align-items:center;gap:7px;color:var(--muted);font-size:10px;cursor:pointer;padding:5px 8px;border:1px solid var(--line);border-radius:5px;background:white}
.notice-preview input {width:14px;height:14px;margin:0;padding:0;accent-color:var(--teal)}
@media(max-width:760px){.page-heading{gap:10px;flex-wrap:wrap}.home-preview-controls{gap:8px}}
</style>
</head>

<body>
<aside class="sidebar" id="sidebar">

  <div class="sidebar-controls">
    <div class="controls-top">
      <span class="controls-label">Navigation</span>
      <button class="width-toggle" id="widthToggle"
              aria-label="Collapse sidebar" title="Collapse sidebar"></button>
    </div>
    <label class="show-all">
      <input type="checkbox" id="showAll">
      <span>Show all submenus</span>
    </label>
  </div>

  <nav class="navigation" id="navigation" aria-label="Main navigation"></nav>

  <div class="side-footer">
    <button data-page="Contact Us">Contact us</button>
    <span style="float:right">2026.11.2</span>
  </div>
</aside>

<div class="main">
  <header>
    <div class="header-main">
	<img
	class="header-logo"
	src="optim8-logo.png"
	alt="Optim8"
	>	
      <button class="mobile-toggle" id="mobileToggle"
              aria-label="Toggle navigation" aria-expanded="false">☰</button>

      <div class="park">
        <strong id="parkName">Demo Park</strong>
        <button class="text-button" id="changeCompany">Change company ⇄</button>
      </div>

      <nav class="utilities" aria-label="Utility navigation">
        <button class="utility" data-page="Tasks">Tasks</button>
        <button class="utility" data-page="Training Documents">Training</button>
        <button class="utility" data-page="All Upgrades to Date">Release history</button>

        <div class="account-wrap">
          <button class="account-button" id="accountButton"
                  aria-label="Admin account menu"
                  aria-expanded="false" aria-controls="accountMenu">
            <span class="avatar">AD</span>
            <span class="account-name">Admin</span>
            <span style="color:#91a0ae;font-size:11px">⌄</span>
          </button>

          <div class="account-menu" id="accountMenu" hidden>
            <div class="menu-heading">
              <strong>Admin</strong>
              <small id="menuPark">Demo Park</small>
            </div>
            <button class="menu-item" id="preferencesButton">Preferences</button>
            <button class="menu-item" id="logoutButton">Logout</button>
          </div>
        </div>
      </nav>
    </div>

    <div class="header-notices" id="headerNotices">
      <div class="notice billing" id="billingNotice">
        <span>
          <strong>Account notice:</strong>
          Resolve the past-due balance before
          <strong>November 18</strong> to avoid service interruption.
        </span>
        <button class="text-button" id="billingDetails">Details →</button>
      </div>

      <div class="notice release" id="releaseNotice">
        <span>
          <strong>November 4 update:</strong>
          Break attestation and Schedule vs. Actual enhancements are available.
        </span>
        <button class="text-button" id="releaseDetails">View update →</button>
      </div>
    </div>
  </header>

  <main class="content">
    <div class="page-heading">
      <h1 id="pageTitle">Home</h1>
      <div class="home-preview-controls">
        <span class="page-date">Thursday, November 5, 2026</span>
        <label class="notice-preview"><input type="checkbox" id="noticePreview" checked aria-controls="headerNotices"><span>Preview: show notices</span></label>
      </div>
    </div>

    <div id="homeContent">
      <div class="home-grid">
        <div>
          <section class="card">
            <div class="card-head">
              <h2>Needs attention</h2>
              <small>Requests & alerts</small>
            </div>
            <div class="attention-grid" id="attention"></div>
            <div class="status">
              <button data-page="Last Posted Schedule">
                Last posted schedule: 7/26/2017 – 7/26/2017
              </button>
              <button data-page="Last Approved Timesheet">
                Last approved timesheet: 4/7/2026
              </button>
              <button data-page="Last Closed Date">
                Last closed date: 3/25/2026
              </button>
            </div>
          </section>

		  <section class="card dashboard-space">
<div class="card-head"><div><h2>Labor overview</h2><small>Illustrative data · Completed week</small></div><select id="laborLocation" aria-label="Filter labor overview by location">
			  <option value="all">All locations</option>
			  <option value="0">Festival Marketplace</option>
			  <option value="1">Capone's Pizzaria</option>
			  <option value="2">Cotton Candy</option>
			  <option value="3">Timbertown Cafe</option>
			  <option value="4">Chicken Chalet</option>
			  </select></div>
<div class="labor-dashboard">
<div class="labor-period">October 26 – November 1, 2026 · Sample data</div>
<div class="labor-metrics" id="laborMetrics"></div>
<div class="labor-chart-heading"><h3>Location Ranking</h3></div>
<div class="labor-table-scroll"><table class="labor-table compact-ranking">
<caption class="labor-sr-only">Location ranking: actual labor vs. budget, scheduled overtime, scheduled and forecast hours per 100 projected guests, and schedule adherence.</caption>
<thead><tr><th scope="col">Location</th><th scope="col">vs. Budget</th><th scope="col">OT %</th><th scope="col">Hrs/100 Guests<small>Scheduled / Forecast</small></th><th scope="col">Adherence</th></tr></thead>
<tbody id="laborTableBody"></tbody></table></div>
<div class="problem-heading"><h3>Top Problem Areas</h3><small>Selected location scope · Sample data</small></div>
<div id="laborProblems"></div>
<p class="labor-footnote">Hrs/100 Guests = location labor hours ÷ projected park attendance × 100. Scheduled and forecast use the same projection; attendance is not allocated to individual locations. No actual attendance or revenue is used.</p>
</div></section>
        </div>

        <section class="card">
          <div class="card-head">
            <h2>Shift notes</h2>
            <button class="primary" id="addNote">＋ Add note</button>
          </div>
          <div class="notes-content" id="notes"></div>
          <div class="notes-footer">
            <button class="text-button" id="allDates">View other dates →</button>
          </div>
        </section>
      </div>
    </div>

    <section class="card destination" id="destinationContent" hidden>
      <h2 id="destinationTitle"></h2>
      <p id="destinationDescription"></p>
      <button class="text-button" id="backHome">← Return home</button>
    </section>

    <footer>
      <span>© 2026 Optim8</span>
      <span>Design concept · Sample data and messages</span>
    </footer>
  </main>
</div>

<div class="flyout" id="flyout" role="region" hidden></div>
<div class="tooltip" id="tooltip" role="tooltip" hidden></div>

<dialog id="dialog" aria-label="Design preview">
  <div id="dialogContent"></div>
</dialog>

<script>
(() => {
  const $ = selector => document.querySelector(selector);
  const sidebar = $("#sidebar");
  const navigation = $("#navigation");
  const dialog = $("#dialog");
  const flyout = $("#flyout");
  const tooltip = $("#tooltip");

  /*
    PREVIEW SETTINGS
    Set either notice to false to hide it.
  */
  const showAccountingMessage = true;
  const showReleaseMessage = true;
  const hasMultipleLinkedParks = true;

  const noticePreview = $("#noticePreview");
  function updateNoticePreview() {
    const show = noticePreview.checked;
    $("#billingNotice").hidden = !show || !showAccountingMessage;
    $("#releaseNotice").hidden = !show || !showReleaseMessage;
    $("#headerNotices").hidden =
      !show || (!showAccountingMessage && !showReleaseMessage);
  }
  noticePreview.addEventListener("change", updateNoticePreview);
  updateNoticePreview();
  $("#changeCompany").hidden = !hasMultipleLinkedParks;

  const storageKey = "optim8-sidebar-complete-v1";
  let settings = { collapsed: false, showAll: false };

  try {
    const saved = JSON.parse(localStorage.getItem(storageKey) || "null");
    if (saved) {
      settings.collapsed = saved.collapsed === true;
      settings.showAll = saved.showAll === true;
    }
  } catch (_) {}

  function saveSettings() {
    try {
      localStorage.setItem(storageKey, JSON.stringify(settings));
    } catch (_) {}
  }

  function esc(value) {
    return String(value).replace(/[&<>"']/g, character => ({
      "&": "&amp;", "<": "&lt;", ">": "&gt;",
      '"': "&quot;", "'": "&#39;"
    }[character]));
  }

  const iconPaths = {
    home:
      '<path d="m3 10 9-7 9 7M5 9v12h14V9M9 21v-8h6v8"/>',
    people:
      '<circle cx="9" cy="8" r="3"/>' +
      '<path d="M3 21v-3a6 6 0 0 1 12 0v3M17 5a3 3 0 0 1 0 6M18 15a5 5 0 0 1 3 4v2"/>',
    tools:
      '<path d="m14 6 4-4a6 6 0 0 1-7 8l-7 7a2.1 2.1 0 0 0 3 3l7-7a6 6 0 0 0 8-7l-4 4z"/>',
    calculator:
      '<rect x="5" y="2" width="14" height="20" rx="2"/>' +
      '<path d="M8 6h8M8 11h1m3 0h1m3 0h.1M8 15h1m3 0h1m3 0h.1M8 19h1m3 0h1m3 0h.1"/>',
    budget:
      '<circle cx="12" cy="12" r="9"/>' +
      '<path d="m6 15 5-5 3 3 4-6m-5 0h5v5"/>',
    calendar:
      '<rect x="3" y="5" width="18" height="16" rx="2"/>' +
      '<path d="M7 3v4m10-4v4M3 10h18M7 14h3m4 0h3m-10 4h3"/>',
    department:
      '<path d="M6 3v18m6-18v18m6-18v18"/>' +
      '<rect x="3" y="6" width="6" height="4" rx="1"/>' +
      '<rect x="9" y="14" width="6" height="4" rx="1"/>' +
      '<rect x="15" y="9" width="6" height="4" rx="1"/>',
    schedule:
      '<path d="M11 21H3V5h17v5M3 9h17M7 3v4m9-4v4"/>' +
      '<circle cx="16" cy="16" r="6"/><path d="M16 12v4l3 2"/>',
    dashboard:
      '<path d="M3 19a10 10 0 1 1 18 0zM12 15l5-7M5 13l2 1m1-7 1 2m6-2-1 2m5 4-2 1"/>',
    chart:
      '<path d="M4 3v18h17M8 17v-5m5 5V8m5 9V4"/>',
    checkin:
      '<circle cx="9" cy="7" r="4"/>' +
      '<path d="M2 21v-3a7 7 0 0 1 12-5m0 4 3 3 5-7"/>',
    timesheet:
      '<path d="M14 21H4V3h16v9M7 8h10M7 12h5m-5 4h4m4 2 3 3 5-7"/>',
    compliance:
      '<path d="M14 3H5v18h14V8zM14 3v5h5M12 11v4"/>' +
      '<circle cx="12" cy="18" r=".6"/>',
    overtime:
      '<rect x="2" y="3" width="20" height="14" rx="2"/>' +
      '<path d="M8 21h8m-4-4v4"/><circle cx="12" cy="10" r="4"/>' +
      '<path d="M12 7v3l2 1"/>',
    optimization:
      '<circle cx="10" cy="10" r="7"/>' +
      '<path d="m15 15 7 7M10 6v8m-4-4h8"/>'
  };

  function icon(name) {
    return `
      <svg class="nav-icon" viewBox="0 0 24 24"
           fill="none" stroke="currentColor" stroke-width="1.6"
           stroke-linecap="round" stroke-linejoin="round"
           aria-hidden="true">
        ${iconPaths[name] || iconPaths.home}
      </svg>
    `;
  }

  const groups = [
    {
      color: "green",
      items: [
        {
          name: "Company", icon: "home",
          children: [
            "Hours Type", "Event", "Rate Code", "Area",
            "Attendance Level", "Template Name",
            "Company Structure", "Options"
          ]
        },
        {
          name: "Human Resources", icon: "people",
          children: [
            "Employee List", "Service Log", "Time Off", "Availability",
            "Employee Certifications", "Notification & Message",
            "Employee Portal Log"
          ]
        },
        {
          name: "Tools", icon: "tools",
          children: [
            "Certifications", "Required Certifications", "Reason & Point",
            "Compliance Rules", "Accrual Rules", "Users", "Activity Log"
          ]
        },
        {
          name: "Payroll", icon: "calculator",
          children: [
            "Payroll Rules", "Payroll Codes",
            "Shift Differential Rules", "Close Date", "Payroll"
          ]
        },
        {
          name: "Budget", icon: "budget",
          children: [
            "Budget Version", "Company Calendar",
            "Department Calendar", "Yearly Budget"
          ]
        }
      ]
    },
    {
      color: "blue",
      items: [
        { name: "Company Calendar", icon: "calendar" },
        { name: "Department Calendar", icon: "department" },
        { name: "Schedule", icon: "schedule" },
        {
          name: "Daily Dashboard", icon: "dashboard",
          children: [
            "Daily Dashboard", "Average Wage & Overtime",
            "Scheduled Labor", "Staff Utilization",
            "Staffing by Hour", "Schedule vs Actual", "Remaining Hours"
          ]
        },
        { name: "Yearly Forecast", icon: "chart" }
      ]
    },
    {
      color: "yellow",
      items: [
        { name: "Check In/Out", icon: "checkin" },
        { name: "Timesheet", icon: "timesheet" },
        { name: "Compliance Monitor", icon: "compliance" },
        { name: "Overtime Monitor", icon: "overtime" },
        { name: "Labor Optimization", icon: "optimization" }
      ]
    }
  ];

  const allItems = groups.flatMap(group => group.items);
  const openMenus = new Set();
  let selectedDestination = "";
  let flyoutTrigger = null;
  let tooltipTrigger = null;

  function renderNavigation() {
    closeFlyout();
    hideTooltip();

    navigation.innerHTML = `
      <button class="home-button" id="homeButton" aria-label="Home"
              data-tooltip="Home">
        ${icon("home")}
        <span class="nav-label">Home</span>
      </button>

      ${groups.map(group => `
        <div class="nav-group ${group.color}">
          ${group.items.map(item => {
            const index = allItems.indexOf(item);
            const expanded = !settings.collapsed &&
              (settings.showAll || openMenus.has(index));

            return `
              <div class="nav-entry">
                <button class="nav-button"
                        data-item="${index}"
                        data-tooltip="${esc(item.name)}"
                        aria-label="${esc(item.name)}"
                        ${item.children
                          ? `aria-expanded="${expanded}"
                             aria-controls="${settings.collapsed
                               ? "flyout" : "submenu-" + index}"`
                          : ""}>
                  ${icon(item.icon)}
                  <span class="nav-label">${esc(item.name)}</span>
                  ${item.children
                    ? `<span class="nav-chevron" aria-hidden="true">
                         ${expanded ? "⌄" : "›"}
                       </span>`
                    : ""}
                </button>

                ${item.children ? `
                  <div class="submenu" id="submenu-${index}"
                       ${expanded ? "" : "hidden"}>
                    ${item.children.map((child, childIndex) => `
                      <button data-parent-index="${index}"
                              data-child-index="${childIndex}"
                              class="${selectedDestination ===
                                item.name + "/" + child ? "selected" : ""}">
                        ${esc(child)}
                      </button>
                    `).join("")}
                  </div>
                ` : ""}
              </div>
            `;
          }).join("")}
        </div>
      `).join("")}
    `;

    $("#homeButton").onclick = () => {
      showHome();
      closeMobileSidebar();
    };

    navigation.querySelectorAll("[data-item]").forEach(button => {
      button.onclick = () => {
        const index = Number(button.dataset.item);
        const item = allItems[index];

        if (!item.children) {
          showDestination(item.name);
          return;
        }

        if (settings.collapsed) {
          openFlyout(item, button);
          return;
        }

        if (!settings.showAll) {
          if (openMenus.has(index)) openMenus.delete(index);
          else openMenus.add(index);

          const scrollPosition = navigation.scrollTop;
          renderNavigation();
          navigation.scrollTop = scrollPosition;
          navigation.querySelector(`[data-item="${index}"]`).focus();
        }
      };
    });

    navigation.querySelectorAll("[data-child-index]").forEach(button => {
      button.onclick = () => {
        const item = allItems[Number(button.dataset.parentIndex)];
        const child = item.children[Number(button.dataset.childIndex)];

        selectedDestination = item.name + "/" + child;

        navigation.querySelectorAll(".submenu button").forEach(other => {
          other.classList.toggle("selected", other === button);
        });

        showDestination(child, item.name);
      };
    });

    navigation.querySelectorAll("[data-tooltip]").forEach(button => {
      button.addEventListener("mouseenter", () => showTooltip(button));
      button.addEventListener("mouseleave", hideTooltip);
      button.addEventListener("focus", () => showTooltip(button));
      button.addEventListener("blur", hideTooltip);
    });
  }

  function applySettings() {
    const focusedControl = document.activeElement;
    closeFlyout();
    hideTooltip();

    document.body.classList.toggle("collapsed", settings.collapsed);

    const label = settings.collapsed ? "Expand sidebar" : "Collapse sidebar";

    $("#widthToggle").setAttribute("aria-label", label);
    $("#widthToggle").setAttribute("aria-expanded", String(!settings.collapsed));
    $("#widthToggle").title = label;
    $("#widthToggle").innerHTML = `
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
           stroke-width="1.6" stroke-linecap="round"
           stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="4" width="18" height="16" rx="2"/>
        <path d="M9 4v16"/>
        ${settings.collapsed
          ? '<path d="m13 9 3 3-3 3"/>'
          : '<path d="m16 9-3 3 3 3"/>'}
      </svg>
    `;

    $("#showAll").checked = settings.showAll;
    renderNavigation();
    saveSettings();

    if (focusedControl === $("#widthToggle")) $("#widthToggle").focus();
  }

  $("#widthToggle").onclick = () => {
    settings.collapsed = !settings.collapsed;
    applySettings();
  };

  $("#showAll").onchange = () => {
    settings.showAll = $("#showAll").checked;
    applySettings();
  };

  function hideTooltip() {
    tooltip.hidden = true;
    if (tooltipTrigger) tooltipTrigger.removeAttribute("aria-describedby");
    tooltipTrigger = null;
  }

  function showTooltip(button) {
    if (!settings.collapsed || !flyout.hidden) return;

    hideTooltip();
    tooltipTrigger = button;
    tooltip.textContent = button.dataset.tooltip;
    tooltip.hidden = false;

    const rect = button.getBoundingClientRect();
    tooltip.style.left = (sidebar.getBoundingClientRect().right + 8) + "px";
    tooltip.style.top = Math.max(
      8,
      Math.min(rect.top, window.innerHeight - tooltip.offsetHeight - 8)
    ) + "px";

    button.setAttribute("aria-describedby", "tooltip");
  }

  function closeFlyout(returnFocus = false) {
    const trigger = flyoutTrigger;
    flyout.hidden = true;
    flyoutTrigger = null;

    if (trigger) {
      trigger.classList.remove("flyout-active");
      trigger.setAttribute("aria-expanded", "false");
      if (returnFocus && trigger.isConnected) trigger.focus();
    }
  }

  function openFlyout(item, button) {
    if (flyoutTrigger === button && !flyout.hidden) {
      closeFlyout(true);
      return;
    }

    closeFlyout();
    hideTooltip();
    flyoutTrigger = button;

    flyout.setAttribute("aria-label", item.name + " submenu");
    flyout.innerHTML = `
      <div class="flyout-heading">
        <span>${esc(item.name)}</span>
        <button class="flyout-close" id="flyoutClose"
                aria-label="Close submenu">×</button>
      </div>
      ${item.children.map((child, index) => `
        <button class="flyout-item" data-flyout-index="${index}">
          ${esc(child)}
        </button>
      `).join("")}
    `;

    flyout.hidden = false;
    button.classList.add("flyout-active");
    button.setAttribute("aria-expanded", "true");

    const rect = button.getBoundingClientRect();
    flyout.style.left = (sidebar.getBoundingClientRect().right + 8) + "px";
    flyout.style.top = Math.max(
      12,
      Math.min(rect.top, window.innerHeight - flyout.offsetHeight - 12)
    ) + "px";

    $("#flyoutClose").onclick = () => closeFlyout(true);

    flyout.querySelectorAll("[data-flyout-index]").forEach(childButton => {
      childButton.onclick = () => {
        const child = item.children[Number(childButton.dataset.flyoutIndex)];
        selectedDestination = item.name + "/" + child;
        closeFlyout();
        showDestination(child, item.name);
      };
    });

    flyout.querySelector(".flyout-item").focus();
  }

  function closeAccount() {
    $("#accountMenu").hidden = true;
    $("#accountButton").setAttribute("aria-expanded", "false");
  }

  function closeMobileSidebar() {
    sidebar.classList.remove("visible");
    $("#mobileToggle").setAttribute("aria-expanded", "false");
  }

  function showHome() {
    closeFlyout();
    hideTooltip();
    closeAccount();
    $("#pageTitle").textContent = "Home";
    $("#homeContent").hidden = false;
    $("#destinationContent").hidden = true;
    selectedDestination = "";
    navigation.querySelectorAll(".selected").forEach(button => {
      button.classList.remove("selected");
    });
  }

  function showDestination(name, parent) {
    closeFlyout();
    hideTooltip();
    closeAccount();
    closeMobileSidebar();

    $("#pageTitle").textContent = name;
    $("#homeContent").hidden = true;
    $("#destinationContent").hidden = false;
    $("#destinationTitle").textContent = parent ? parent + " / " + name : name;
    $("#destinationDescription").textContent =
      "This represents the " + name + " page in Optim8. " +
      "Use the sidebar arrow to compare the available page width " +
      "with the menu expanded or collapsed.";

    $("#pageTitle").setAttribute("tabindex", "-1");
    $("#pageTitle").focus();
  }

  $("#backHome").onclick = showHome;

  $("#mobileToggle").onclick = () => {
    const visible = sidebar.classList.toggle("visible");
    $("#mobileToggle").setAttribute("aria-expanded", String(visible));
  };

  const attentionItems = [
    ["Non-Paid Time Off Requests", 1],
    ["Paid Time Off Requests", 21],
    ["Availability Requests To Be Processed", 9],
    ["New Messages", 0],
    ["Drop And Cover Schedule Requests", 13],
    ["Trade Schedule Requests", 3],
    ["Requests To Pickup Unassigned Schedule", 19],
    ["Pending Timesheet Correction Requests", 2],
    ["Employees Still Clocked In", 4, true],
    ["Availability Date Range Required", null, true]
  ];

  $("#attention").innerHTML = attentionItems.map(item => `
    <button class="attention-link ${item[2] ? "critical" : ""}"
            data-page="${esc(item[0])}">
      <span>${esc(item[0])}</span>
      ${item[1] === null ? "<span>↗</span>" : `
        <span class="badge ${item[1] === 0 ? "zero" : ""}">
          ${item[1]}
        </span>
      `}
    </button>
  `).join("");

  document.querySelectorAll("[data-page]").forEach(button => {
    button.onclick = () => showDestination(button.dataset.page);
  });

  function openDialog(content) {
    closeAccount();
    closeFlyout();
    hideTooltip();

    $("#dialogContent").innerHTML = content + `
      <div class="dialog-actions">
        <button class="secondary" id="closeDialog">Close</button>
      </div>
    `;

    $("#closeDialog").onclick = () => dialog.close();
    if (!dialog.open) dialog.showModal();
  }

  $("#accountButton").onclick = () => {
    const opening = $("#accountMenu").hidden;
    $("#accountMenu").hidden = !opening;
    $("#accountButton").setAttribute("aria-expanded", String(opening));
  };

  $("#preferencesButton").onclick = () => {
    const preferences = [
      "Change password",
      "Phone & email",
      "Linked accounts",
      "Notification preferences",
      "Page defaults"
    ];

    openDialog(`
      <h2>Preferences</h2>
      <p>${esc($("#parkName").textContent)} / Admin</p>

      <label for="preferenceCollapsed">
        <input type="checkbox" id="preferenceCollapsed"
               style="width:auto;margin-right:8px"
               ${settings.collapsed ? "checked" : ""}>
        Use icons-only sidebar
      </label>

      <label for="preferenceShowAll">
        <input type="checkbox" id="preferenceShowAll"
               style="width:auto;margin-right:8px"
               ${settings.showAll ? "checked" : ""}>
        Show all submenus when expanded
      </label>

      <p>Sidebar choices apply immediately and are remembered in this browser.</p>

      ${preferences.map(item => `
        <button class="option" data-preference="${esc(item)}">
          ${esc(item)} <span>→</span>
        </button>
      `).join("")}
    `);

    $("#preferenceCollapsed").onchange = event => {
      settings.collapsed = event.target.checked;
      applySettings();
    };

    $("#preferenceShowAll").onchange = event => {
      settings.showAll = event.target.checked;
      applySettings();
    };

    document.querySelectorAll("[data-preference]").forEach(button => {
      button.onclick = () => openDialog(`
        <h2>${esc(button.dataset.preference)}</h2>
        <p>The existing preference settings would open here.</p>
      `);
    });
  };

  $("#logoutButton").onclick = () => openDialog(`
    <h2>Logout</h2>
    <p>
      In Optim8, this would end the session and return to login.
      This mockup is not connected to an account.
    </p>
  `);

  $("#changeCompany").onclick = () => {
    openDialog(`
      <h2>Change company</h2>
      <p>Your linked parks</p>
      ${["Demo Park", "North Park", "West Park"].map(park => `
        <button class="option" data-park="${park}">
          ${park} <span>→</span>
        </button>
      `).join("")}
    `);

    document.querySelectorAll("[data-park]").forEach(button => {
      button.onclick = () => {
        $("#parkName").textContent = button.dataset.park;
        $("#menuPark").textContent = button.dataset.park;
        dialog.close();
      };
    });
  };

  $("#billingDetails").onclick = () => openDialog(`
    <h2>Account notice</h2>
    <p>
      Your account has a past-due balance. Please contact billing
      before November 18 to avoid service interruption.
    </p>
    <p>Sample wording and date for the design preview.</p>
  `);

  $("#releaseDetails").onclick = () => openDialog(`
    <h2>November 4 release update</h2>
    <p><strong>Timesheets — Break Attestation Filter</strong></p>
    <p>Filter timesheets based on employee break attestations.</p>

    <p><strong>Timecard Corrections — Break Attestation</strong></p>
    <p>
      Employees can include break attestation information when submitting
      timecard corrections through the web Employee Portal.
      Administrators can review this information during approval.
    </p>

    <p><strong>Schedule vs. Actual — Additional Filters</strong></p>
    <p>
      Filter for No Call No Show or Checked in Late exceptions,
      including a specified number of minutes late.
    </p>
  `);

  const days = [
    ["Yesterday", "2026-11-04"],
    ["Today", "2026-11-05"],
    ["Tomorrow", "2026-11-06"]
  ];

  const notes = {
    "2026-11-04": [{
      title: "Closing handoff",
      text: "Party rooms were reset before close. Please confirm supplies at opening.",
      author: "Jordan Lee · 8:45 PM"
    }],
    "2026-11-05": [{
      title: "Opening reminders",
      text: "Check party room assignments before the first session.",
      author: "Alex Morgan · 8:15 AM"
    }],
    "2026-11-06": [{
      title: "Group arrival preparation",
      text: "Review coverage before the morning group arrives.",
      author: "Taylor Reed · 3:00 PM"
    }]
  };

  function formatDate(date) {
    return new Date(date + "T12:00:00").toLocaleDateString(
      "en-US", { month: "short", day: "numeric" }
    );
  }

  function renderNotes() {
    $("#notes").innerHTML = days
      .filter(day => (notes[day[1]] || []).length)
      .map(day => `
        <div class="day-group">
          <div class="day-label">
            <span>${day[0]}</span>
            <span>${formatDate(day[1])}</span>
          </div>
          ${notes[day[1]].map((note, index) => `
            <button class="note"
                    data-note-date="${day[1]}"
                    data-note-index="${index}">
              <strong>${esc(note.title)} ↗</strong>
              <p>${esc(note.text)}</p>
              <small>${esc(note.author)}</small>
            </button>
          `).join("")}
        </div>
      `).join("") || `
        <p style="font-size:12px;color:var(--muted)">
          No notes for yesterday, today, or tomorrow.
        </p>
      `;

    document.querySelectorAll("[data-note-date]").forEach(button => {
      button.onclick = () => {
        const date = button.dataset.noteDate;
        const note = notes[date][Number(button.dataset.noteIndex)];

        openDialog(`
          <h2>${esc(note.title)}</h2>
          <p style="white-space:pre-wrap">${esc(note.text)}</p>
          <p>${esc(note.author)} · ${formatDate(date)}</p>
          <button class="primary" id="noteAdd">＋ Add note</button>
          <button class="text-button" id="noteBrowse"
                  style="margin-left:15px">View other dates</button>
        `);

        $("#noteAdd").onclick = () => addNote(date);
        $("#noteBrowse").onclick = browseNotes;
      };
    });
  }

  function addNote(date = "2026-11-05") {
    openDialog(`
      <h2>Add shift note</h2>
      <form id="noteForm">
        <label for="noteDate">Date</label>
        <input id="noteDate" type="date" value="${esc(date)}" required>

        <label for="noteTitle">Title</label>
        <input id="noteTitle" maxlength="100" required>

        <label for="noteText">Note</label>
        <textarea id="noteText" required></textarea>

        <button class="primary" style="margin-top:17px">Save note</button>
      </form>
    `);

    $("#noteForm").onsubmit = event => {
      event.preventDefault();

      const selectedDate = $("#noteDate").value;
      if (!notes[selectedDate]) notes[selectedDate] = [];

      notes[selectedDate].push({
        title: $("#noteTitle").value,
        text: $("#noteText").value,
        author: "Admin · Just now"
      });

      renderNotes();
      dialog.close();

      if (!days.some(day => day[1] === selectedDate)) {
        openDialog(`
          <h2>Note saved</h2>
          <p>Your note is available under View other dates.</p>
        `);
      }
    };
  }

  function browseNotes() {
    openDialog(`
      <h2>Shift notes · Other dates</h2>
      <label for="browseDate">Choose a date</label>
      <input id="browseDate" type="date" value="2026-11-05">
      <div id="browseResults" style="margin:20px 0"></div>
      <button class="primary" id="browseAdd">＋ Add note</button>
    `);

    function refresh() {
      $("#browseResults").innerHTML =
        (notes[$("#browseDate").value] || []).map(note => `
          <div style="margin-bottom:20px">
            <strong style="font-size:12px">${esc(note.title)}</strong>
            <p style="white-space:pre-wrap">${esc(note.text)}</p>
            <small style="color:var(--muted)">${esc(note.author)}</small>
          </div>
        `).join("") || "<p>No notes for this date.</p>";
    }

    $("#browseDate").onchange = refresh;
    $("#browseAdd").onclick = () => addNote($("#browseDate").value);
    refresh();
  }

  $("#addNote").onclick = () => addNote();
  $("#allDates").onclick = browseNotes;

  document.addEventListener("click", event => {
    if (!event.target.closest(".account-wrap")) closeAccount();

    if (
      !flyout.contains(event.target) &&
      !(flyoutTrigger && flyoutTrigger.contains(event.target))
    ) {
      closeFlyout();
    }

    if (
      !event.target.closest(".sidebar") &&
      !event.target.closest("#mobileToggle") &&
      !event.target.closest("#flyout")
    ) {
      closeMobileSidebar();
    }
  });

  document.addEventListener("keydown", event => {
    if (event.key === "Escape") {
      closeFlyout(true);
      hideTooltip();

      if (!$("#accountMenu").hidden) {
        closeAccount();
        $("#accountButton").focus();
      }

      closeMobileSidebar();
    }

    if (event.key === "Tab" && !flyout.hidden) {
      setTimeout(() => {
        if (
          !flyout.contains(document.activeElement) &&
          document.activeElement !== flyoutTrigger
        ) {
          closeFlyout();
        }
      }, 0);
    }
  });

  navigation.addEventListener("scroll", () => {
    closeFlyout();
    hideTooltip();
  });

  window.addEventListener("resize", () => {
    closeFlyout();
    hideTooltip();
  });

  window.addEventListener("scroll", () => {
    closeFlyout();
    hideTooltip();
  }, { passive: true });

  dialog.addEventListener("click", event => {
    if (event.target === dialog) dialog.close();
  });

  applySettings();
  renderNotes();
})();
</script>

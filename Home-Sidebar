</style>
<script>
(() => {
  const filter = document.getElementById('laborLocation');
  const attendance = 12500;
  // Illustrative hours. Forecast is a separate planning value from budget.
  const locations = [
    {name:"Festival Marketplace",budget:420,scheduled:432,forecast:410,actual:445,otHours:24,shifts:100,adherent:89},
    {name:"Capone's Pizzaria",budget:360,scheduled:350,forecast:345,actual:355,otHours:12,shifts:80,adherent:75},
    {name:"Cotton Candy",budget:160,scheduled:156,forecast:160,actual:148,otHours:1,shifts:40,adherent:39},
    {name:"Timbertown Cafe",budget:300,scheduled:312,forecast:295,actual:325,otHours:18,shifts:90,adherent:82},
    {name:"Chicken Chalet",budget:280,scheduled:276,forecast:280,actual:290,otHours:4,shifts:70,adherent:67}
  ];
  const $ = id => document.getElementById(id);
  const esc = x => String(x).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const n = x => x.toLocaleString('en-US',{maximumFractionDigits:1});
  const pct = x => x.toFixed(1)+'%';
  const signed = x => (x>0?'+':'')+pct(x);
  const budget = l => (l.actual/l.budget-1)*100;
  const ot = l => l.otHours/l.scheduled*100;
  const guests = l => l.scheduled/attendance*100;
  const forecast = l => l.forecast/attendance*100;
  const adherence = l => l.adherent/l.shifts*100;
  function render(){
    const visible=filter.value==='all'?locations:[locations[Number(filter.value)]];
    const sum=key=>visible.reduce((v,l)=>v+l[key],0);
    const variance=(sum('actual')/sum('budget')-1)*100;
    const otTotal=sum('otHours')/sum('scheduled')*100;
    const adherenceTotal=sum('adherent')/sum('shifts')*100;
    const cards=[
      ['Labor vs. budget',signed(variance),n(sum('actual')-sum('budget'))+' hours over budget',variance>0?'labor-over':'labor-under'],
      ['Scheduled overtime',pct(otTotal),'Sample target: 5%',otTotal>5?'labor-caution':'labor-under'],
      ['Schedule adherence',pct(adherenceTotal),'Sample target: 95%',adherenceTotal<95?'labor-caution':'labor-under'],
      ['Hrs/100 Guests',(sum('scheduled')/attendance*100).toFixed(2),'Forecast: '+(sum('forecast')/attendance*100).toFixed(2),'']
    ];
    // Report under-budget hours accurately when filtering a location.
    if(variance<0) cards[0][2]=n(sum('budget')-sum('actual'))+' hours under budget';
    $('laborMetrics').innerHTML=cards.map(c=>`<div class="labor-metric"><span class="labor-metric-label">${c[0]}</span><strong class="labor-metric-value ${c[3]}">${c[1]}</strong><span class="labor-metric-note">${c[2]}</span></div>`).join('');
    const ranked=[...visible].sort((a,b)=>budget(a)-budget(b));
    $('laborTableBody').innerHTML=ranked.map(l=>`<tr>
      <td>${esc(l.name)}</td>
      <td class="${budget(l)>3?'labor-over':budget(l)>0?'labor-caution':'labor-under'}">${signed(budget(l))}</td>
      <td class="${ot(l)>5?'labor-caution':''}">${pct(ot(l))}</td>
      <td>${guests(l).toFixed(2)} <span style="color:var(--muted)">/ ${forecast(l).toFixed(2)}</span></td>
      <td class="${adherence(l)<90?'labor-over':adherence(l)<95?'labor-caution':'labor-under'}">${pct(adherence(l))}</td>
    </tr>`).join('');
    const worst=f=>[...visible].sort((a,b)=>f(b)-f(a))[0];
    const b=worst(budget),o=worst(ot),a=worst(l=>100-adherence(l));
    const problems=[];
    if(budget(b)>0)problems.push([b.name,'Actual labor over budget',signed(budget(b))]);
    if(ot(o)>5)problems.push([o.name,'Scheduled OT above sample 5% threshold',pct(ot(o))]);
    if(adherence(a)<95)problems.push([a.name,'Adherence below sample 95% target',pct(adherence(a))]);
    $('laborProblems').innerHTML=problems.length?problems.map(p=>`<div class="problem-row"><div><strong>${esc(p[0])}</strong></div><small>${p[1]}</small><b>${p[2]}</b></div>`).join(''):'<p class="labor-footnote">No problem areas at the sample thresholds for this location.</p>';
  }
  filter.addEventListener('change',render);
  render();
})();
</script>

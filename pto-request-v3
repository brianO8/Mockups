<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Time Off Request</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'system-ui', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#f0f9ff',
                            100: '#e0f2fe',
                            500: '#0284c7',
                            600: '#0369a1',
                            700: '#075985',
                        },
                        accent: {
                            50: '#f7fee7',
                            100: '#ecfccb',
                            500: '#84cc16',
                            600: '#65a30d',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>
</head>
<body class="bg-slate-900 font-sans min-h-screen flex justify-center items-center p-0 sm:p-4 text-slate-800 antialiased">

    <!-- Mobile Device Container -->
    <div class="w-full max-w-[412px] h-[100vh] sm:h-[870px] bg-slate-50 sm:rounded-[40px] shadow-2xl flex flex-col overflow-hidden relative border-0 sm:border-[8px] border-slate-800">

        <!-- Mobile Status Bar -->
        <div class="bg-slate-900 text-white px-6 pt-3 pb-2 flex justify-between items-center text-xs font-semibold select-none z-30 shrink-0">
            <span>9:41</span>
            <div class="w-20 h-4 bg-slate-950 rounded-full mx-auto absolute left-0 right-0 top-2 hidden sm:block"></div>
            <div class="flex items-center space-x-1.5">
                <i class="fa-solid fa-signal text-[10px]"></i>
                <i class="fa-solid fa-wifi text-[10px]"></i>
                <i class="fa-solid fa-battery-full text-xs"></i>
            </div>
        </div>

        <!-- App Header Bar -->
        <div class="bg-white border-b border-slate-200 px-4 py-3 flex items-center justify-between shadow-sm z-20 shrink-0">
            <button class="text-slate-600 hover:text-slate-900 text-sm font-medium flex items-center gap-1.5 transition-colors">
                <i class="fa-solid fa-chevron-left text-xs"></i>
                <span>Back</span>
            </button>
            <h1 class="text-base font-bold text-slate-900 tracking-tight">Request Time Off</h1>
            <button onclick="resetToDefaults()" class="text-brand-600 hover:text-brand-700 text-xs font-semibold">
                Reset
            </button>
        </div>

        <!-- Scrollable Content Viewport -->
        <div id="scroll-container" class="flex-1 overflow-y-auto no-scrollbar p-3.5 space-y-3.5 pb-28">

            <!-- Card 1: Airline Booking Style Date Range Picker -->
            <div class="bg-white rounded-2xl p-4 shadow-sm border border-slate-200/80 space-y-3">
                
                <!-- Date Range Header & Badge -->
                <div class="flex items-center justify-between">
                    <div>
                        <span class="text-[10px] font-bold tracking-wider text-slate-400 uppercase block mb-0.5">Date Range</span>
                        <div class="text-sm font-bold text-slate-900 flex items-center gap-1.5">
                            <i class="fa-regular fa-calendar-days text-brand-500"></i>
                            <span id="date-range-display-text">Select Start & End Date</span>
                        </div>
                    </div>
                    <span id="total-days-badge" class="bg-brand-50 text-brand-700 text-xs font-bold px-2.5 py-1 rounded-full border border-brand-100">
                        -- Days
                    </span>
                </div>

                <!-- Collapsed Date Summary Bar -->
                <div id="collapsed-date-summary" class="hidden flex items-center justify-between bg-slate-50 border border-slate-200/80 p-2.5 rounded-xl">
                    <div class="flex items-center gap-2">
                        <i class="fa-solid fa-circle-check text-brand-500 text-sm"></i>
                        <span id="collapsed-dates-text" class="text-xs font-bold text-slate-800">Nov 2 – Nov 8, 2026</span>
                    </div>
                    <button onclick="openCalendarForEdit()" class="text-xs font-bold text-brand-600 hover:text-brand-700 bg-white border border-slate-200 px-2.5 py-1 rounded-lg shadow-sm">
                        Change
                    </button>
                </div>

                <!-- Inline Airline Style Calendar Picker Widget -->
                <div id="expanded-calendar-widget" class="space-y-3 pt-1">
                    <div class="flex justify-between items-center text-xs font-bold text-slate-800 px-1">
                        <button onclick="changeMonth(-1)" class="text-slate-400 hover:text-slate-700 p-1"><i class="fa-solid fa-chevron-left"></i></button>
                        <span id="cal-month-title">November
